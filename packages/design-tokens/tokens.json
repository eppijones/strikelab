{
  "$schema": "./tokens.schema.json",
  "name": "StrikeLab Design Tokens",
  "version": "0.1.0",
  "color": {
    "dark": {
      "bg": "#0a0b0a",
      "bg2": "#111312",
      "surface": "#15181680",
      "surfaceSolid": "#151816",
      "surface2": "#1c1f1d",
      "line": "#25292680",
      "lineStrong": "#2d322f",
      "ink": "#ede8de",
      "ink2": "#b9b6ac",
      "ink3": "#76746b",
      "ink4": "#4a4842",
      "accent": "oklch(0.88 0.18 125)",
      "accentInk": "#0a0b0a",
      "accent2": "oklch(0.78 0.18 125)",
      "warn": "oklch(0.78 0.16 65)",
      "bad": "oklch(0.68 0.20 28)"
    },
    "light": {
      "bg": "#ede8de",
      "bg2": "#e3ddd0",
      "surface": "#f5f1e780",
      "surfaceSolid": "#f5f1e7",
      "surface2": "#ebe5d6",
      "line": "#c8c2b240",
      "lineStrong": "#b6af9c",
      "ink": "#141614",
      "ink2": "#4a4842",
      "ink3": "#76746b",
      "ink4": "#b6af9c",
      "accent": "oklch(0.62 0.18 145)",
      "accentInk": "#ede8de",
      "accent2": "oklch(0.52 0.18 145)",
      "warn": "oklch(0.55 0.18 50)",
      "bad": "oklch(0.55 0.20 28)"
    }
  },
  "typography": {
    "sans": "Geist, system-ui, -apple-system, sans-serif",
    "mono": "Geist Mono, ui-monospace, monospace",
    "serif": "Instrument Serif, Times New Roman, serif",
    "scale": {
      "displayXl": { "size": 96, "weight": 500, "tracking": "-0.04em", "lineHeight": 0.95 },
      "displayL": { "size": 64, "weight": 500, "tracking": "-0.04em", "lineHeight": 0.95 },
      "displayM": { "size": 40, "weight": 500, "tracking": "-0.04em", "lineHeight": 1.0 },
      "head": { "size": 24, "weight": 500, "tracking": "-0.02em", "lineHeight": 1.2 },
      "body": { "size": 15, "weight": 400, "tracking": "0", "lineHeight": 1.5 },
      "micro": { "size": 10, "weight": 500, "tracking": "0.18em", "lineHeight": 1.0, "uppercase": true }
    }
  },
  "motion": {
    "launch": { "curve": "cubic-bezier(0.2, 0.9, 0.3, 1)", "duration": 240 },
    "settle": { "curve": "cubic-bezier(0.16, 1, 0.3, 1)", "duration": 480 },
    "trace": { "curve": "cubic-bezier(0.65, 0, 0.35, 1)", "duration": 900 },
    "micro": { "curve": "ease-out", "duration": 120 }
  },
  "shape": {
    "radiusPanel": 2,
    "radiusPill": 999,
    "borderHairline": 1
  },
  "spacing": {
    "panelPadX": 14,
    "panelPadY": 10,
    "pageGutter": 32,
    "sectionGutter": 56,
    "gridGap": 16
  }
}
