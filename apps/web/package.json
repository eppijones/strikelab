{
  "name": "strikelab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "npm install --no-save --package-lock=false @vitejs/plugin-react vite typescript tailwindcss postcss autoprefixer && npx vite build",
    "build:strict": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "echo \"No ESLint config is currently checked in; use npm run typecheck for static verification.\""
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@tanstack/react-query": "^5.17.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "framer-motion": "^12.23.26",
    "i18next": "^23.7.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.21.1",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
