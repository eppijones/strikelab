// Common build settings shared by Debug + Release.
// `//` is parsed as a comment delimiter inside xcconfig values, so
// embed the URL scheme with the `$()` placeholder trick.
URL_SCHEME_HTTP  = http:/$()/
URL_SCHEME_HTTPS = https:/$()/

// Public Clerk key for local development. Release.xcconfig must supply the
// production key through Local.xcconfig, CI, or Xcode Cloud settings.
CLERK_PUBLISHABLE_KEY =

// Pull in Local.xcconfig (gitignored) last so per-developer and archive
// overrides win over shared defaults. See apps/ios/Config/Local.xcconfig.sample.
#include? "Local.xcconfig"
