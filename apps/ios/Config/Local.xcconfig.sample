// Copy to Local.xcconfig (gitignored) only for private build settings.
// The iPhone and Watch app use https://strikelab.golf/api by default.

// Use a Clerk publishable key locally. For App Store archives, provide the
// production pk_live value through an uncommitted Local.xcconfig, CI, or
// Xcode Cloud build setting. Never put CLERK_SECRET_KEY in iOS config.
CLERK_PUBLISHABLE_KEY = pk_test_replace_me
